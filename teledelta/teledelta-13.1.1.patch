+package org.telegram.messenger.teledelta;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.ContactsController;
+import org.telegram.messenger.DialogObject;
+import org.telegram.messenger.MessageObject;
+import org.telegram.messenger.MessagesController;
+import org.telegram.messenger.NotificationCenter;
+import org.telegram.messenger.UserConfig;
+import org.telegram.messenger.UserObject;
+import org.telegram.tgnet.TLRPC;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.Set;
+
+/**
+ * «Работа» в TeleDelta: какие чаты считаются рабочими, их список и рабочий режим уведомлений.
+ *
+ * Рабочий чат — это либо выбранный вручную (группа, канал, человек), либо подходящий под
+ * отмеченный тип: «контакты» и «не контакты» — это личные переписки, они включены по умолчанию.
+ * Хранится локально, отдельно для каждого аккаунта; на сервер и на другие устройства не уходит.
+ */
+public final class TeleDeltaWork {
+
+    public static final String APP_NAME = "TeleDelta";
+
+    // «Работа» — только то, что выбрано вручную: никаких «все личные переписки» по типу.
+    private static final int DEFAULT_FLAGS = 0;
+
+    private static final Object lock = new Object();
+    @SuppressWarnings("unchecked")
+    private static final Set<Long>[] idsCache = new Set[UserConfig.MAX_ACCOUNT_COUNT];
+
+    private TeleDeltaWork() {
+    }
+
+    private static SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences("teledelta", Context.MODE_PRIVATE);
+    }
+
+    // ---- выбор ------------------------------------------------------------------------------
+
+    public static Set<Long> getIds(int account) {
+        synchronized (lock) {
+            Set<Long> s = idsCache[account];
+            if (s == null) {
+                s = new HashSet<>();
+                String raw = prefs().getString("work_ids_" + account, "");
+                for (String p : raw.split(",")) {
+                    if (p.isEmpty()) {
+                        continue;
+                    }
+                    try {
+                        s.add(Long.parseLong(p));
+                    } catch (NumberFormatException ignore) {
+                    }
+                }
+                idsCache[account] = s;
+            }
+            return s;
+        }
+    }
+
+    public static ArrayList<Long> getIdsList(int account) {
+        synchronized (lock) {
+            return new ArrayList<>(getIds(account));
+        }
+    }
+
+    public static int getFlags(int account) {
+        // Ключ сменён намеренно: прежний по умолчанию включал все личные переписки.
+        return prefs().getInt("work_flags2_" + account, DEFAULT_FLAGS);
+    }
+
+    public static void setSelection(int account, ArrayList<Long> ids, int flags) {
+        synchronized (lock) {
+            idsCache[account] = new HashSet<>(ids);
+            save(account);
+        }
+        prefs().edit().putInt("work_flags2_" + account, flags & MessagesController.DIALOG_FILTER_FLAG_ALL_CHATS).apply();
+        changed(account);
+    }
+
+    public static boolean isExplicit(int account, long dialogId) {
+        synchronized (lock) {
+            return getIds(account).contains(dialogId);
+        }
+    }
+
+    /** Добавить в «Работу» (add) или убрать из неё сразу несколько чатов. */
+    public static void setMany(int account, java.util.List<Long> dialogIds, boolean add) {
+        synchronized (lock) {
+            Set<Long> s = getIds(account);
+            if (add) {
+                s.addAll(dialogIds);
+            } else {
+                s.removeAll(dialogIds);
+            }
+            save(account);
+        }
+        changed(account);
+    }
+
+    /** Добавить в «Работу» или убрать из неё. Возвращает новое состояние. */
+    public static boolean toggle(int account, long dialogId) {
+        boolean now;
+        synchronized (lock) {
+            Set<Long> s = getIds(account);
+            if (s.contains(dialogId)) {
+                s.remove(dialogId);
+                now = false;
+            } else {
+                s.add(dialogId);
+                now = true;
+            }
+            save(account);
+        }
+        changed(account);
+        return now;
+    }
+
+    private static void save(int account) {
+        StringBuilder sb = new StringBuilder();
+        for (Long id : idsCache[account]) {
+            if (sb.length() > 0) {
+                sb.append(',');
+            }
+            sb.append(id);
+        }
+        prefs().edit().putString("work_ids_" + account, sb.toString()).apply();
+    }
+
+    private static void changed(int account) {
+        NotificationCenter.getInstance(account).postNotificationName(NotificationCenter.dialogsNeedReload);
+        NotificationCenter.getInstance(account).postNotificationName(NotificationCenter.updateInterfaces, MessagesController.UPDATE_MASK_READ_DIALOG_MESSAGE);
+    }
+
+    /** Рабочий ли это чат: выбран вручную или подходит под отмеченный тип. */
+    public static boolean isWork(int account, long dialogId) {
+        if (isExplicit(account, dialogId)) {
+            return true;
+        }
+        int flags = getFlags(account);
+        if (flags == 0) {
+            return false;
+        }
+        MessagesController mc = MessagesController.getInstance(account);
+        if (DialogObject.isEncryptedDialog(dialogId)) {
+            return false;
+        }
+        if (DialogObject.isUserDialog(dialogId)) {
+            TLRPC.User user = mc.getUser(dialogId);
+            if (user == null || UserObject.isUserSelf(user) || UserObject.isReplyUser(user) || UserObject.isService(dialogId)) {
+                return false;
+            }
+            if (user.bot) {
+                return (flags & MessagesController.DIALOG_FILTER_FLAG_BOTS) != 0;
+            }
+            if (user.contact || ContactsController.getInstance(account).isContact(dialogId)) {
+                return (flags & MessagesController.DIALOG_FILTER_FLAG_CONTACTS) != 0;
+            }
+            return (flags & MessagesController.DIALOG_FILTER_FLAG_NON_CONTACTS) != 0;
+        }
+        TLRPC.Chat chat = mc.getChat(-dialogId);
+        if (chat == null) {
+            return false;
+        }
+        if (org.telegram.messenger.ChatObject.isChannelAndNotMegaGroup(chat)) {
+            return (flags & MessagesController.DIALOG_FILTER_FLAG_CHANNELS) != 0;
+        }
+        return (flags & MessagesController.DIALOG_FILTER_FLAG_GROUPS) != 0;
+    }
+
+    // ---- список -----------------------------------------------------------------------------
+
+    public static boolean isOnlyUnread() {
+        return prefs().getBoolean("work_only_unread", false);
+    }
+
+    public static void setOnlyUnread(int account, boolean value) {
+        prefs().edit().putBoolean("work_only_unread", value).apply();
+        changed(account);
+    }
+
+    /**
+     * Рабочие чаты: и из основного списка, и из архива — архив для работы не повод пропасть.
+     * Порядок — закреплённые в «Работе» вручную выше, дальше по времени последнего сообщения.
+     */
+    public static ArrayList<TLRPC.Dialog> getDialogs(int account) {
+        MessagesController mc = MessagesController.getInstance(account);
+        ArrayList<TLRPC.Dialog> result = new ArrayList<>();
+        HashSet<Long> seen = new HashSet<>();
+        boolean onlyUnread = isOnlyUnread();
+        for (int folder = 0; folder <= 1; folder++) {
+            ArrayList<TLRPC.Dialog> list = mc.getDialogs(folder);
+            if (list == null) {
+                continue;
+            }
+            for (int i = 0, n = list.size(); i < n; i++) {
+                TLRPC.Dialog d = list.get(i);
+                if (d == null || d instanceof TLRPC.TL_dialogFolder || !seen.add(d.id)) {
+                    continue;
+                }
+                if (!isWork(account, d.id)) {
+                    continue;
+                }
+                if (onlyUnread && d.unread_count == 0 && d.unread_mentions_count == 0 && !d.unread_mark) {
+                    continue;
+                }
+                result.add(d);
+            }
+        }
+        Collections.sort(result, (a, b) -> {
+            boolean pa = isPinned(account, a.id), pb = isPinned(account, b.id);
+            if (pa != pb) {
+                return pa ? -1 : 1;
+            }
+            int da = Math.max(a.last_message_date, draftDate(a)), db = Math.max(b.last_message_date, draftDate(b));
+            return Integer.compare(db, da);
+        });
+        return result;
+    }
+
+    private static int draftDate(TLRPC.Dialog d) {
+        return d.draft != null ? d.draft.date : 0;
+    }
+
+    public static boolean isPinned(int account, long dialogId) {
+        return prefs().getBoolean("work_pin_" + account + "_" + dialogId, false);
+    }
+
+    public static boolean togglePinned(int account, long dialogId) {
+        boolean now = !isPinned(account, dialogId);
+        SharedPreferences.Editor e = prefs().edit();
+        if (now) {
+            e.putBoolean("work_pin_" + account + "_" + dialogId, true);
+        } else {
+            e.remove("work_pin_" + account + "_" + dialogId);
+        }
+        e.apply();
+        changed(account);
+        return now;
+    }
+
+    /** Число рабочих чатов с непрочитанным (без заглушённых) — для значка на вкладке. */
+    public static int getUnreadChatsCount(int account) {
+        MessagesController mc = MessagesController.getInstance(account);
+        int count = 0;
+        for (TLRPC.Dialog d : getDialogs(account)) {
+            if ((d.unread_count > 0 || d.unread_mark) && !mc.isDialogMuted(d.id, 0)) {
+                count++;
+            }
+        }
+        return count;
+    }
+
+    // ---- режим приложения ---------------------------------------------------------------------
+
+    /**
+     * «Рабочий» (по умолчанию) или «Обычный». В рабочем приложение открывается на «Работе» и
+     * прячет лишнее: истории, Premium/Звёзды/Подарки/Business, рекламу в каналах.
+     */
+    public static boolean isWorkMode() {
+        return prefs().getBoolean("mode_work", true);
+    }
+
+    public static void setWorkMode(boolean value) {
+        prefs().edit().putBoolean("mode_work", value).apply();
+        for (int a = 0; a < UserConfig.MAX_ACCOUNT_COUNT; a++) {
+            if (UserConfig.getInstance(a).isClientActivated()) {
+                changed(a);
+                NotificationCenter.getInstance(a).postNotificationName(NotificationCenter.storiesUpdated);
+            }
+        }
+        org.telegram.ui.DialogsActivity.notifyTeleDeltaProfileChanged();
+    }
+
+    // ---- рабочий режим уведомлений ----------------------------------------------------------
+
+    public static boolean isFocusMode() {
+        return prefs().getBoolean("work_focus", false);
+    }
+
+    public static void setFocusMode(boolean value) {
+        prefs().edit().putBoolean("work_focus", value).apply();
+    }
+
+    /**
+     * В рабочем режиме уведомления приходят только из «Работы» и когда упомянули лично.
+     * Если про чат ещё ничего не известно (не загружен), уведомление не глушим: лучше лишнее,
+     * чем пропущенное рабочее.
+     */
+    public static boolean isNotificationBlocked(int account, long dialogId, MessageObject message) {
+        if (!isFocusMode()) {
+            return false;
+        }
+        if (message != null && message.messageOwner != null && message.messageOwner.mentioned) {
+            return false;
+        }
+        MessagesController mc = MessagesController.getInstance(account);
+        if (DialogObject.isUserDialog(dialogId) && mc.getUser(dialogId) == null) {
+            return false;
+        }
+        if (DialogObject.isChatDialog(dialogId) && mc.getChat(-dialogId) == null) {
+            return false;
+        }
+        return !isWork(account, dialogId);
+    }
+}
