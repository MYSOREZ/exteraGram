+        center.addView(logo, LayoutHelper.createLinear(120, 120, Gravity.CENTER_HORIZONTAL, 0, 0, 0, 28));
+
+        TextView title = new TextView(context);
+        title.setText("TeleDelta");
+        title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 30);
+        title.setTypeface(AndroidUtilities.bold());
+        title.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText));
+        title.setGravity(Gravity.CENTER);
+        center.addView(title, LayoutHelper.createLinear(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT, Gravity.CENTER_HORIZONTAL, 0, 0, 0, 12));
+
+        TextView subtitle = new TextView(context);
+        subtitle.setText("Рабочий мессенджер.\nРабочие чаты и личные сообщения — отдельно от всего остального.");
+        subtitle.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16);
+        subtitle.setLineSpacing(AndroidUtilities.dp(3), 1f);
+        subtitle.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText));
+        subtitle.setGravity(Gravity.CENTER);
+        center.addView(subtitle, LayoutHelper.createLinear(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT, Gravity.CENTER_HORIZONTAL));
+
+        TextView note = new TextView(context);
+        note.setText("Вход — по номеру телефона вашего аккаунта Telegram.\nПереписка зашифрована протоколом MTProto.");
+        note.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13);
+        note.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText));
+        note.setGravity(Gravity.CENTER);
+        note.setEllipsize(TextUtils.TruncateAt.END);
+        root.addView(note, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, Gravity.BOTTOM, 24, 0, 24, 100));
+
+        TextView start = new TextView(context);
+        start.setText("Войти");
+        start.setGravity(Gravity.CENTER);
+        start.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16);
+        start.setTypeface(AndroidUtilities.bold());
+        start.setTextColor(Theme.getColor(Theme.key_featuredStickers_buttonText));
+        start.setBackground(Theme.createSimpleSelectorRoundRectDrawable(AndroidUtilities.dp(24),
+                Theme.getColor(Theme.key_featuredStickers_addButton), Theme.getColor(Theme.key_featuredStickers_addButtonPressed)));
+        start.setOnClickListener(v -> {
+            if (started) {
+                return;
+            }
+            started = true;
+            presentFragment(new LoginActivity(), true);
+        });
+        root.addView(start, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, 50, Gravity.BOTTOM, 24, 0, 24, 32));
+
+        // Экран рисуется под системными панелями — отступаем от них сами.
+        androidx.core.view.ViewCompat.setOnApplyWindowInsetsListener(root, (v, insets) -> {
+            androidx.core.graphics.Insets i = insets.getInsets(androidx.core.view.WindowInsetsCompat.Type.systemBars());
+            v.setPadding(0, i.top, 0, i.bottom);
+            return insets;
+        });
+
+        fragmentView = root;
+        return root;
+    }
+
+    @Override
+    public boolean isLightStatusBar() {
+        return ColorUtils.calculateLuminance(Theme.getColor(Theme.key_windowBackgroundWhite, null, true)) > 0.7f;
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/teledelta/TeleDeltaWorkUi.java b/TMessagesProj/src/main/java/org/telegram/ui/teledelta/TeleDeltaWorkUi.java
new file mode 100644
index 0000000..19516bb
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/ui/teledelta/TeleDeltaWorkUi.java
@@ -0,0 +1,128 @@
+package org.telegram.ui.teledelta;
+
+import org.telegram.messenger.R;
+import org.telegram.messenger.teledelta.TeleDeltaWork;
+import org.telegram.ui.ActionBar.ActionBarMenuSubItem;
+import org.telegram.ui.ActionBar.ActionBarPopupWindow;
+import org.telegram.ui.ActionBar.BaseFragment;
+import org.telegram.ui.Components.BulletinFactory;
+import org.telegram.ui.Components.ItemOptions;
+import org.telegram.ui.DialogsActivity;
+import org.telegram.ui.UsersSelectActivity;
+
+/** Интерфейс «Работы» TeleDelta: меню вкладки, пункты долгого нажатия на чат, выбор чатов. */
+public final class TeleDeltaWorkUi {
+
+    private TeleDeltaWorkUi() {
+    }
+
+    /** Меню «⋮» во вкладке «Работа». */
+    public static void fillOptions(DialogsActivity fragment, ItemOptions io) {
+        final int account = fragment.getCurrentAccount();
+        io.add(R.drawable.msg_edit, "Выбрать рабочие чаты", () -> openPicker(fragment));
+        io.addGap();
+        io.addChecked(TeleDeltaWork.isOnlyUnread(), "Только непрочитанные", () ->
+                TeleDeltaWork.setOnlyUnread(account, !TeleDeltaWork.isOnlyUnread()));
+        io.addChecked(TeleDeltaWork.isFocusMode(), "Рабочий режим уведомлений", () -> {
+            boolean now = !TeleDeltaWork.isFocusMode();
+            TeleDeltaWork.setFocusMode(now);
+            BulletinFactory.of(fragment).createSimpleBulletin(R.raw.chats_infotip, now
+                    ? "Уведомления — только из «Работы» и когда вас упомянули"
+                    : "Уведомления — как обычно, из всех чатов").show();
+        });
+        io.addGap();
+        io.add(R.drawable.msg_work, "Перейти в обычный профиль", () -> switchProfile(fragment));
+    }
+
+    private static boolean emptyHintShown;
+
+    /** Переключить профиль «Рабочий» ⇄ «Обычный» — без перезапуска. */
+    public static void switchProfile(BaseFragment fragment) {
+        boolean now = !TeleDeltaWork.isWorkMode();
+        TeleDeltaWork.setWorkMode(now);
+        BulletinFactory.of(fragment).createSimpleBulletin(R.raw.contact_check, now
+                ? "Рабочий профиль: только рабочие чаты"
+                : "Обычный профиль: все чаты, как в Telegram").show();
+        if (now) {
+            emptyHintShown = false;
+            if (fragment instanceof DialogsActivity) {
+                onWorkTabResumed((DialogsActivity) fragment);
+            }
+        }
+    }
+
+    /** Пустая «Работа» — подсказать один раз за запуск, как её наполнить. */
+    public static void onWorkTabResumed(DialogsActivity fragment) {
+        if (emptyHintShown || fragment.getParentActivity() == null) {
+            return;
+        }
+        final int account = fragment.getCurrentAccount();
+        if (!TeleDeltaWork.getIds(account).isEmpty()) {
+            return;
+        }
+        emptyHintShown = true;
+        org.telegram.messenger.AndroidUtilities.runOnUIThread(() -> {
+            if (fragment.getParentActivity() == null) {
+                return;
+            }
+            BulletinFactory.of(fragment).createSimpleBulletin(R.raw.chats_infotip,
+                    "«Работа» пуста. Добавьте чаты: ⋮ → «Выбрать рабочие чаты» или долгое нажатие на чат",
+                    "Выбрать", () -> openPicker(fragment)).show();
+        }, 600);
+    }
+
+    /** Кнопка-портфель на панели выделенных чатов. */
+    public static void applySelection(DialogsActivity fragment, java.util.ArrayList<Long> ids, boolean add) {
+        if (ids == null || ids.isEmpty()) {
+            return;
+        }
+        TeleDeltaWork.setMany(fragment.getCurrentAccount(), ids, add);
+        String n = ids.size() == 1 ? "Чат" : "Чатов: " + ids.size() + ",";
+        BulletinFactory.of(fragment).createSimpleBulletin(R.raw.contact_check, add
+                ? (ids.size() == 1 ? "Чат добавлен в «Работу»" : "Добавлено в «Работу»: " + ids.size())
+                : (ids.size() == 1 ? "Чат убран из «Работы»" : "Убрано из «Работы»: " + ids.size())).show();
+    }
+
+    /** Выбор рабочих чатов — тем же экраном, которым Telegram собирает папки. */
+    public static void openPicker(BaseFragment fragment) {
+        final int account = fragment.getCurrentAccount();
+        UsersSelectActivity picker = new UsersSelectActivity(true, TeleDeltaWork.getIdsList(account), TeleDeltaWork.getFlags(account));
+        picker.noLimit = true;
+        // Без «типов чатов»: в «Работу» попадают только отмеченные по одному группы и люди.
+        picker.noChatTypes = true;
+        picker.setDelegate((ids, flags) -> TeleDeltaWork.setSelection(account, ids, 0));
+        fragment.presentFragment(picker);
+    }
+
+    /** Пункты в меню долгого нажатия на чат: добавить/убрать из «Работы», закрепить в ней. */
+    public static void addPreviewItems(DialogsActivity fragment, ActionBarPopupWindow.ActionBarPopupWindowLayout menu, long dialogId) {
+        if (menu == null || fragment.getParentActivity() == null) {
+            return;
+        }
+        final int account = fragment.getCurrentAccount();
+        final boolean explicit = TeleDeltaWork.isExplicit(account, dialogId);
+
+        ActionBarMenuSubItem workItem = new ActionBarMenuSubItem(fragment.getParentActivity(), false, false);
+        workItem.setTextAndIcon(explicit ? "Убрать из «Работы»" : "Добавить в «Работу»", R.drawable.msg_work);
+        workItem.setMinimumWidth(160);
+        workItem.setOnClickListener(v -> {
+            boolean now = TeleDeltaWork.toggle(account, dialogId);
+            fragment.finishPreviewFragment();
+            String text = now ? "Чат добавлен в «Работу»" : "Чат убран из «Работы»";
+            BulletinFactory.of(fragment).createSimpleBulletin(R.raw.contact_check, text).show();
+        });
+        menu.addView(workItem);
+
+        if (fragment.isWorkFiltered()) {
+            final boolean pinned = TeleDeltaWork.isPinned(account, dialogId);
+            ActionBarMenuSubItem pinItem = new ActionBarMenuSubItem(fragment.getParentActivity(), false, false);
+            pinItem.setTextAndIcon(pinned ? "Открепить в «Работе»" : "Закрепить в «Работе»", pinned ? R.drawable.msg_unpin : R.drawable.msg_pin);
+            pinItem.setMinimumWidth(160);
+            pinItem.setOnClickListener(v -> {
+                TeleDeltaWork.togglePinned(account, dialogId);
+                fragment.finishPreviewFragment();
+            });
+            menu.addView(pinItem);
+        }
+    }
+}
