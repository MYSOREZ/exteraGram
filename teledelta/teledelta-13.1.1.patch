+package org.telegram.messenger.tgws;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ActionBar.BaseFragment;
+
+/** Окно состояния встроенного sTGWS: что подобрано, что отвечает, последние ошибки. */
+public final class TgwsDiag {
+    private TgwsDiag() {
+    }
+
+    public static void show(BaseFragment fragment) {
+        if (fragment == null || fragment.getParentActivity() == null) {
+            return;
+        }
+        String text = Tgws.getDiagnostics();
+        AlertDialog.Builder builder = new AlertDialog.Builder(fragment.getParentActivity());
+        builder.setTitle("sTGWS");
+        builder.setMessage(text);
+        builder.setPositiveButton("Копировать", (d, w) -> AndroidUtilities.addToClipboard(text));
+        builder.setNeutralButton("Перепроверить", (d, w) -> Tgws.forcePick());
+        builder.setNegativeButton("Закрыть", null);
+        fragment.showDialog(builder.create());
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/tgws/TgwsMtproto.java b/TMessagesProj/src/main/java/org/telegram/messenger/tgws/TgwsMtproto.java
new file mode 100644
index 0000000..ece6147
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/tgws/TgwsMtproto.java
@@ -0,0 +1,293 @@
+package org.telegram.messenger.tgws;
+
+import java.security.SecureRandom;
+
+import javax.crypto.Cipher;
+import javax.crypto.spec.IvParameterSpec;
+import javax.crypto.spec.SecretKeySpec;
+
+/**
+ * Всё, что мосту нужно знать про транспорт MTProto: разбор и правка первых 64 байт
+ * (obfuscated2), нарезка потока на пакеты и проба «ответил ли дата-центр».
+ *
+ * Мост поток НЕ расшифровывает и не перешифровывает: клиент и дата-центр говорят друг с
+ * другом напрямую, а мост лишь перекладывает байты. Ключи из заголовка нужны только чтобы
+ * знать границы пакетов — точка kwsN ждёт каждый пакет отдельным кадром веб-сокета.
+ */
+final class TgwsMtproto {
+
+    static final int INIT_LEN = 64;
+    static final int PROTO_ABRIDGED = 0xefefefef;
+    static final int PROTO_INTERMEDIATE = 0xeeeeeeee;
+    static final int PROTO_PADDED = 0xdddddddd;
+
+    private static final SecureRandom RANDOM = new SecureRandom();
+
+    private TgwsMtproto() {
+    }
+
+    static Cipher ctr(byte[] key, int keyOff, byte[] iv, int ivOff) throws Exception {
+        Cipher c = Cipher.getInstance("AES/CTR/NoPadding");
+        byte[] k = new byte[32];
+        byte[] v = new byte[16];
+        System.arraycopy(key, keyOff, k, 0, 32);
+        System.arraycopy(iv, ivOff, v, 0, 16);
+        c.init(Cipher.ENCRYPT_MODE, new SecretKeySpec(k, "AES"), new IvParameterSpec(v));
+        return c;
+    }
+
+    /** Шифр клиент→сервер, уже прокрученный на 64 байта заголовка. */
+    static Cipher clientCipher(byte[] init) throws Exception {
+        Cipher c = ctr(init, 8, init, 40);
+        c.update(new byte[INIT_LEN]);
+        return c;
+    }
+
+    private static byte[] keystream(byte[] init) throws Exception {
+        return ctr(init, 8, init, 40).update(new byte[INIT_LEN]);
+    }
+
+    static final class Info {
+        int proto;
+        int dc;          // 0 — в заголовке не записан
+        boolean media;
+    }
+
+    /** null — это не obfuscated2 (значит, не трогаем и пропускаем как есть). */
+    static Info parse(byte[] init) {
+        try {
+            byte[] ks = keystream(init);
+            byte[] p = new byte[8];
+            for (int i = 0; i < 8; i++) {
+                p[i] = (byte) (init[56 + i] ^ ks[56 + i]);
+            }
+            int proto = (p[0] & 0xff) | (p[1] & 0xff) << 8 | (p[2] & 0xff) << 16 | (p[3] & 0xff) << 24;
+            if (proto != PROTO_ABRIDGED && proto != PROTO_INTERMEDIATE && proto != PROTO_PADDED) {
+                return null;
+            }
+            Info info = new Info();
+            info.proto = proto;
+            short raw = (short) ((p[4] & 0xff) | (p[5] & 0xff) << 8);
+            int dc = Math.abs(raw);
+            // Без секрета прокси tgnet байты 60–61 не заполняет — там случайность. Номер
+            // принимаем, только если он похож на настоящий; иначе ДЦ берётся по адресу.
+            if ((dc >= 1 && dc <= 5) || dc == 203) {
+                info.dc = dc;
+                info.media = raw < 0;
+            }
+            return info;
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    /** Вписывает номер ДЦ в заголовок (точке kwsN он нужен; самому ДЦ — безразличен). */
+    static byte[] patchDc(byte[] init, int dc, boolean media) {
+        byte[] out = init.clone();
+        try {
+            byte[] ks = keystream(init);
+            short v = (short) (media ? -dc : dc);
+            out[60] = (byte) (ks[60] ^ (v & 0xff));
+            out[61] = (byte) (ks[61] ^ ((v >> 8) & 0xff));
+        } catch (Exception ignore) {
+        }
+        return out;
+    }
+
+    /**
+     * Нарезка шифрованного потока клиента на транспортные пакеты. Каждый пакет уходит в
+     * веб-сокет отдельным кадром — иначе точка kwsN склеенные пакеты не принимает.
+     */
+    static final class Splitter {
+        private final Cipher cipher;
+        private final int proto;
+        private byte[] enc = new byte[0];
+        private byte[] plain = new byte[0];
+        private boolean disabled;
+
+        Splitter(byte[] init, int proto) throws Exception {
+            this.cipher = clientCipher(init);
+            this.proto = proto;
+        }
+
+        interface Out {
+            void packet(byte[] b, int off, int len) throws java.io.IOException;
+        }
+
+        void feed(byte[] chunk, int off, int len, Out out) throws java.io.IOException {
+            if (len <= 0) {
+                return;
+            }
+            if (disabled) {
+                out.packet(chunk, off, len);
+                return;
+            }
+            byte[] dec = cipher.update(chunk, off, len);
+            enc = concat(enc, chunk, off, len);
+            plain = concat(plain, dec, 0, dec == null ? 0 : dec.length);
+            int pos = 0;
+            while (pos < enc.length) {
+                int n = nextLen(pos);
+                if (n == 0) {
+                    break; // пакет ещё не дочитан
+                }
+                if (n < 0) {
+                    // Непонятная длина — дальше режем не пакетами, а как пришло.
+                    out.packet(enc, pos, enc.length - pos);
+                    pos = enc.length;
+                    disabled = true;
+                    break;
+                }
+                out.packet(enc, pos, n);
+                pos += n;
+            }
+            if (pos > 0) {
+                enc = tail(enc, pos);
+                plain = tail(plain, pos);
+            }
+        }
+
+        private int nextLen(int pos) {
+            int avail = plain.length - pos;
+            if (avail <= 0) {
+                return 0;
+            }
+            if (proto == PROTO_ABRIDGED) {
+                int first = plain[pos] & 0xff;
+                int payload;
+                int header = 1;
+                if (first == 0x7f || first == 0xff) {
+                    if (avail < 4) {
+                        return 0;
+                    }
+                    payload = ((plain[pos + 1] & 0xff) | (plain[pos + 2] & 0xff) << 8 | (plain[pos + 3] & 0xff) << 16) * 4;
+                    header = 4;
+                } else {
+                    payload = (first & 0x7f) * 4;
+                }
+                if (payload <= 0) {
+                    return -1;
+                }
+                return avail >= header + payload ? header + payload : 0;
+            }
+            if (avail < 4) {
+                return 0;
+            }
+            int payload = ((plain[pos] & 0xff) | (plain[pos + 1] & 0xff) << 8 | (plain[pos + 2] & 0xff) << 16 | (plain[pos + 3] & 0x7f) << 24);
+            if (payload <= 0 || payload > 16 * 1024 * 1024) {
+                return -1;
+            }
+            return avail >= 4 + payload ? 4 + payload : 0;
+        }
+    }
+
+    private static byte[] concat(byte[] a, byte[] b, int off, int len) {
+        byte[] r = new byte[a.length + len];
+        System.arraycopy(a, 0, r, 0, a.length);
+        if (len > 0) {
+            System.arraycopy(b, off, r, a.length, len);
+        }
+        return r;
+    }
+
+    private static byte[] tail(byte[] a, int from) {
+        byte[] r = new byte[a.length - from];
+        System.arraycopy(a, from, r, 0, r.length);
+        return r;
+    }
+
+    // ---- проба: req_pq_multi → resPQ -------------------------------------------------------
+
+    /** Готовая проба: заголовок, первый пакет и расшифровщик ответа. */
+    static final class Probe {
+        byte[] init;
+        byte[] packet;
+        Cipher decrypt;
+        byte[] nonce = new byte[16];
+    }
+
+    static Probe makeProbe(int dc, boolean media) throws Exception {
+        byte[] b = new byte[INIT_LEN];
+        while (true) {
+            RANDOM.nextBytes(b);
+            int v1 = (b[0] & 0xff) | (b[1] & 0xff) << 8 | (b[2] & 0xff) << 16 | (b[3] & 0xff) << 24;
+            int v2 = (b[4] & 0xff) | (b[5] & 0xff) << 8 | (b[6] & 0xff) << 16 | (b[7] & 0xff) << 24;
+            if ((b[0] & 0xff) != 0xef && v1 != 0x44414548 && v1 != 0x54534f50 && v1 != 0x20544547
+                    && v1 != 0x4954504f && v1 != 0xeeeeeeee && v1 != 0xdddddddd && v1 != 0x02010316 && v2 != 0) {
+                break;
+            }
+        }
+        b[56] = b[57] = b[58] = b[59] = (byte) 0xef;
+        short d = (short) (media ? -dc : dc);
+        b[60] = (byte) (d & 0xff);
+        b[61] = (byte) ((d >> 8) & 0xff);
+
+        byte[] rev = new byte[48];
+        for (int i = 0; i < 48; i++) {
+            rev[i] = b[55 - i];
+        }
+        Cipher enc = ctr(b, 8, b, 40);
+        Cipher dec = ctr(rev, 0, rev, 32);
+        byte[] encrypted = enc.update(b);
+        Probe p = new Probe();
+        p.init = b.clone();
+        System.arraycopy(encrypted, 56, p.init, 56, 8);
+
+        RANDOM.nextBytes(p.nonce);
+        byte[] payload = new byte[40];
+        // auth_key_id = 0
+        long msgId = (System.currentTimeMillis() / 1000L) << 32 | ((long) RANDOM.nextInt() & 0xfffffffcL);
+        putLong(payload, 8, msgId);
+        putInt(payload, 16, 20);
+        putInt(payload, 20, 0xbe7e8ef1); // req_pq_multi
+        System.arraycopy(p.nonce, 0, payload, 24, 16);
+        byte[] plainPacket = new byte[41];
+        plainPacket[0] = (byte) (payload.length / 4);
+        System.arraycopy(payload, 0, plainPacket, 1, payload.length);
+        p.packet = enc.update(plainPacket);
+        p.decrypt = dec;
+        return p;
+    }
+
+    /** Ответ на пробу — это resPQ с нашим nonce. Проверяем ровно это, а не «что-то пришло». */
+    static boolean checkProbeAnswer(Probe p, byte[] data, int len) {
+        if (len < 1 + 40) {
+            return false;
+        }
+        byte[] d = p.decrypt.update(data, 0, len);
+        int off = 1;
+        if ((d[0] & 0xff) == 0x7f) {
+            off = 4;
+        }
+        if (d.length < off + 40) {
+            return false;
+        }
+        for (int i = 0; i < 8; i++) {
+            if (d[off + i] != 0) {
+                return false;
+            }
+        }
+        int ctor = (d[off + 20] & 0xff) | (d[off + 21] & 0xff) << 8 | (d[off + 22] & 0xff) << 16 | (d[off + 23] & 0xff) << 24;
+        if (ctor != 0x05162463) {
+            return false;
+        }
+        for (int i = 0; i < 16; i++) {
+            if (d[off + 24 + i] != p.nonce[i]) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static void putInt(byte[] b, int off, int v) {
+        b[off] = (byte) v;
+        b[off + 1] = (byte) (v >> 8);
+        b[off + 2] = (byte) (v >> 16);
+        b[off + 3] = (byte) (v >> 24);
+    }
+
+    private static void putLong(byte[] b, int off, long v) {
+        putInt(b, off, (int) v);
+        putInt(b, off + 4, (int) (v >> 32));
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/tgws/TgwsWebSocket.java b/TMessagesProj/src/main/java/org/telegram/messenger/tgws/TgwsWebSocket.java
new file mode 100644
index 0000000..a9bf9d5
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/tgws/TgwsWebSocket.java
@@ -0,0 +1,324 @@
+package org.telegram.messenger.tgws;
+
+import android.util.Base64;
+
+import java.io.BufferedInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.EOFException;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.Inet4Address;
+import java.net.InetAddress;
+import java.net.InetSocketAddress;
+import java.net.Socket;
+import java.nio.charset.StandardCharsets;
+import java.security.SecureRandom;
+import java.util.ArrayList;
+import java.util.List;
+
+import javax.net.ssl.HostnameVerifier;
+import javax.net.ssl.HttpsURLConnection;
+import javax.net.ssl.SSLSocket;
+import javax.net.ssl.SSLSocketFactory;
+
+/**
+ * Минимальный клиент веб-сокета: TLS к kwsN.<домен>:443, апгрейд на /apiws и двоичные кадры.
+ * Ничего лишнего — ровно то, что говорит Telegram Web со своими точками.
+ */
+final class TgwsWebSocket {
+
+    private static final SecureRandom RANDOM = new SecureRandom();
+
+    private final SSLSocket socket;
+    private final InputStream in;
+    private final OutputStream out;
+    private final Object writeLock = new Object();
+    private volatile boolean closed;
+
+    private TgwsWebSocket(SSLSocket socket, InputStream in, OutputStream out) {
+        this.socket = socket;
+        this.in = in;
+        this.out = out;
+    }
+
+    static final class HandshakeException extends IOException {
+        final int status;
+
+        HandshakeException(int status, String line) {
+            super("HTTP " + status + ": " + line);
+            this.status = status;
+        }
+    }
+
+    static TgwsWebSocket connect(String host, int timeoutMs) throws IOException {
+        InetAddress[] all = InetAddress.getAllByName(host);
+        // Сначала IPv4: у мобильных операторов IPv6 бывает «есть, но не везёт».
+        List<InetAddress> order = new ArrayList<>();
+        for (InetAddress a : all) {
+            if (a instanceof Inet4Address) {
+                order.add(a);
+            }
+        }
+        for (InetAddress a : all) {
+            if (!(a instanceof Inet4Address)) {
+                order.add(a);
+            }
+        }
+        IOException last = null;
+        int tries = 0;
+        for (InetAddress addr : order) {
+            if (tries++ >= 2) {
+                break;
+            }
+            Socket raw = new Socket();
+            try {
+                raw.setTcpNoDelay(true);
+                raw.connect(new InetSocketAddress(addr, 443), timeoutMs);
+                return handshake(raw, host, timeoutMs);
+            } catch (HandshakeException e) {
+                closeQuietly(raw);
+                throw e; // сервер ответил — другой адрес того же имени ответит так же
+            } catch (IOException e) {
+                closeQuietly(raw);
+                last = e;
+            }
+        }
+        throw last != null ? last : new IOException("no address for " + host);
+    }
+
+    private static TgwsWebSocket handshake(Socket raw, String host, int timeoutMs) throws IOException {
+        raw.setSoTimeout(timeoutMs);
+        SSLSocketFactory f = HttpsURLConnection.getDefaultSSLSocketFactory();
+        SSLSocket s = (SSLSocket) f.createSocket(raw, host, 443, true);
+        s.setUseClientMode(true);
+        // SNI обязателен: без имени в ClientHello Cloudflare не знает, чей сертификат отдать,
+        // и рвёт рукопожатие. Ставим его явно — обоими способами, какой сработает на прошивке.
+        try {
+            s.getClass().getMethod("setHostname", String.class).invoke(s, host);
+        } catch (Throwable ignore) {
+        }
+        if (android.os.Build.VERSION.SDK_INT >= 24) {
+            try {
+                javax.net.ssl.SSLParameters p = s.getSSLParameters();
+                p.setServerNames(java.util.Collections.singletonList(new javax.net.ssl.SNIHostName(host)));
+                s.setSSLParameters(p);
+            } catch (Throwable ignore) {
+            }
+        }
+        s.startHandshake();
+        HostnameVerifier hv = HttpsURLConnection.getDefaultHostnameVerifier();
+        if (!hv.verify(host, s.getSession())) {
+            closeQuietly(s);
+            throw new IOException("bad certificate for " + host);
+        }
+        byte[] keyBytes = new byte[16];
+        RANDOM.nextBytes(keyBytes);
+        String key = Base64.encodeToString(keyBytes, Base64.NO_WRAP);
+        String req = "GET /apiws HTTP/1.1\r\n"
+                + "Host: " + host + "\r\n"
+                + "Upgrade: websocket\r\n"
+                + "Connection: Upgrade\r\n"
+                + "Sec-WebSocket-Key: " + key + "\r\n"
+                + "Sec-WebSocket-Version: 13\r\n"
+                + "Sec-WebSocket-Protocol: binary\r\n"
+                + "\r\n";
+        OutputStream out = s.getOutputStream();
+        out.write(req.getBytes(StandardCharsets.US_ASCII));
+        out.flush();
+        InputStream in = new BufferedInputStream(s.getInputStream(), 65536);
+        String status = readLine(in);
+        int code = 0;
+        String[] parts = status.split(" ");
+        if (parts.length >= 2) {
+            try {
+                code = Integer.parseInt(parts[1].trim());
+            } catch (NumberFormatException ignore) {
+            }
+        }
+        while (true) {
+            String line = readLine(in);
+            if (line.isEmpty()) {
+                break;
+            }
+        }
+        if (code != 101) {
+            closeQuietly(s);
+            throw new HandshakeException(code, status);
+        }
+        s.setSoTimeout(0);
+        return new TgwsWebSocket(s, in, out);
+    }
+
+    private static String readLine(InputStream in) throws IOException {
+        ByteArrayOutputStream b = new ByteArrayOutputStream(128);
+        while (true) {
+            int c = in.read();
+            if (c < 0) {
+                throw new EOFException("handshake: connection closed");
+            }
+            if (c == '\n') {
+                break;
+            }
+            if (c != '\r') {
+                b.write(c);
+            }
+            if (b.size() > 8192) {
+                throw new IOException("handshake: line too long");
+            }
+        }
+        return b.toString("ISO-8859-1");
+    }
+
+    void setReadTimeout(int ms) {
+        try {
+            socket.setSoTimeout(ms);
+        } catch (IOException ignore) {
+        }
+    }
+
+    void sendBinary(byte[] data, int off, int len) throws IOException {
+        sendFrame(0x2, data, off, len);
+    }
+
+    private void sendFrame(int opcode, byte[] data, int off, int len) throws IOException {
+        int headerLen = 2 + 4 + (len < 126 ? 0 : len < 65536 ? 2 : 8);
+        byte[] frame = new byte[headerLen + len];
+        int p = 0;
+        frame[p++] = (byte) (0x80 | opcode);
+        if (len < 126) {
+            frame[p++] = (byte) (0x80 | len);
+        } else if (len < 65536) {
+            frame[p++] = (byte) (0x80 | 126);
+            frame[p++] = (byte) (len >> 8);
+            frame[p++] = (byte) len;
+        } else {
+            frame[p++] = (byte) (0x80 | 127);
+            long l = len;
+            for (int i = 7; i >= 0; i--) {
+                frame[p++] = (byte) (l >> (8 * i));
+            }
+        }
+        byte[] mask = new byte[4];
+        RANDOM.nextBytes(mask);
+        System.arraycopy(mask, 0, frame, p, 4);
+        p += 4;
+        for (int i = 0; i < len; i++) {
+            frame[p + i] = (byte) (data[off + i] ^ mask[i & 3]);
+        }
+        synchronized (writeLock) {
+            out.write(frame);
+            out.flush();
+        }
+    }
+
+    /**
+     * Следующее сообщение с данными. null — сокет закрыт. Пинги отвечаются здесь же,
+     * фрагменты склеиваются.
+     */
+    byte[] receive() throws IOException {
+        ByteArrayOutputStream frag = null;
+        while (true) {
+            int b0 = in.read();
+            if (b0 < 0) {
+                return null;
+            }
+            int b1 = readByte();
+            boolean fin = (b0 & 0x80) != 0;
+            int opcode = b0 & 0x0f;
+            boolean masked = (b1 & 0x80) != 0;
+            long len = b1 & 0x7f;
+            if (len == 126) {
+                len = (readByte() << 8) | readByte();
+            } else if (len == 127) {
+                len = 0;
+                for (int i = 0; i < 8; i++) {
+                    len = (len << 8) | readByte();
+                }
+            }
+            if (len < 0 || len > 16 * 1024 * 1024) {
+                throw new IOException("ws: frame too large");
+            }
+            byte[] mask = null;
+            if (masked) {
+                mask = new byte[4];
+                readFully(mask);
+            }
+            byte[] payload = new byte[(int) len];
+            readFully(payload);
+            if (mask != null) {
+                for (int i = 0; i < payload.length; i++) {
+                    payload[i] ^= mask[i & 3];
+                }
+            }
+            switch (opcode) {
+                case 0x8: // close
+                    return null;
+                case 0x9: // ping
+                    sendFrame(0xA, payload, 0, payload.length);
+                    continue;
+                case 0xA: // pong
+                    continue;
+                case 0x0: // продолжение
+                    if (frag == null) {
+                        frag = new ByteArrayOutputStream();
+                    }
+                    frag.write(payload);
+                    if (fin) {
+                        return frag.toByteArray();
+                    }
+                    continue;
+                default:
+                    if (fin && frag == null) {
+                        return payload;
+                    }
+                    frag = new ByteArrayOutputStream();
+                    frag.write(payload);
+                    if (fin) {
+                        return frag.toByteArray();
+                    }
+            }
+        }
+    }
+
+    private int readByte() throws IOException {
+        int b = in.read();
+        if (b < 0) {
+            throw new EOFException();
+        }
+        return b;
+    }
+
+    private void readFully(byte[] b) throws IOException {
+        int n = 0;
+        while (n < b.length) {
+            int r = in.read(b, n, b.length - n);
+            if (r < 0) {
+                throw new EOFException();
+            }
+            n += r;
+        }
+    }
+
+    void close() {
+        if (closed) {
+            return;
+        }
+        closed = true;
+        try {
+            sendFrame(0x8, new byte[0], 0, 0);
+        } catch (Throwable ignore) {
+        }
+        closeQuietly(socket);
+    }
+
+    static void closeQuietly(Socket s) {
+        if (s == null) {
+            return;
+        }
+        try {
+            s.close();
+        } catch (Throwable ignore) {
+        }
+    }
+}
